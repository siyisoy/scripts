bar {
    #font pango:Inconsolata 10
    font pango:SourceCodeProForPowerline 10
    position top  
    tray_output none  

    status_command /home/user/.local/bin/bumblebee-status \
     -m  memory spacer pasource spacer brightness spacer xrandr spacer  date spacer time \
     -p root.path=/ time.format="%H:%M:%S" date.format="%a, %b %d %Y" \
     -t dracula-powerline 
    colors {
     separator $purple
     background $darkgrey  
     statusline $white  
     focused_workspace $mediumgrey $grey $darkgrey $purple
     active_workspace  $lightblue $mediumgrey $darkgrey $purple
     inactive_workspace  $darkgrey $darkgrey  $grey $purple
     urgent_workspace  $urgentred $urgentred $white $purple
}

}


